[Unit]
Description=moip-toolkit web UI
After=network-online.target avahi-daemon.service
Wants=network-online.target

[Service]
# RX / multiview / signage render straight to the display via KMS/DRM: no
# desktop session on that display, and the user in the `video` and `input` groups.
ExecStart=%h/moip-toolkit/bin/moip web --host 0.0.0.0 --port 8000
# To show them on a desktop session instead:
#ExecStart=%h/moip-toolkit/bin/moip web --host 0.0.0.0 --port 8000 --video-driver auto
WorkingDirectory=%h/moip-toolkit
Restart=always
RestartSec=3
# Cap memory so a runaway process is killed (and restarted) instead of taking down the OS
MemoryHigh=1G
MemoryMax=1500M
Environment=XDG_RUNTIME_DIR=/run/user/%U

[Install]
WantedBy=default.target
