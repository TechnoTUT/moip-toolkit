[Unit]
Description=moip-toolkit NDI receiver
After=network-online.target avahi-daemon.service
Wants=network-online.target

[Service]
# Renders straight to the display via KMS/DRM: no desktop session on that
# display, and the user in the `video` and `input` groups.
ExecStart=%h/moip-toolkit/bin/moip rx -s "__SOURCE_NAME__"
# To show the viewer on a desktop session instead:
#ExecStart=%h/moip-toolkit/bin/moip rx -s "__SOURCE_NAME__" --fullscreen --video-driver auto
WorkingDirectory=%h/moip-toolkit
Restart=always
RestartSec=3
# Cap memory so a runaway process is killed (and restarted) instead of taking down the OS
MemoryHigh=1G
MemoryMax=1500M
Environment=XDG_RUNTIME_DIR=/run/user/%U

[Install]
WantedBy=default.target
