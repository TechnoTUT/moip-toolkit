[Unit]
Description=NDI Receiver (SDL2)
After=network.target

[Service]
ExecStart=%h/utone-ndi-utils/.venv/bin/python %h/utone-ndi-utils/main.py rx -s "__SOURCE_NAME__" --fullscreen
# Lowest latency on a dedicated display machine (no desktop session; user in `video` and `input` groups):
#ExecStart=%h/utone-ndi-utils/.venv/bin/python %h/utone-ndi-utils/main.py rx -s "__SOURCE_NAME__" --fullscreen --video-driver kmsdrm
WorkingDirectory=%h/utone-ndi-utils
Restart=always
RestartSec=3
# Cap memory so a runaway process is killed (and restarted) instead of taking down the OS
MemoryHigh=1G
MemoryMax=1500M
Environment=XDG_RUNTIME_DIR=/run/user/%U

[Install]
WantedBy=default.target