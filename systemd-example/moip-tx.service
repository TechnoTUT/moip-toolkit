[Unit]
Description=moip-toolkit NDI sender
After=network-online.target avahi-daemon.service
Wants=network-online.target

[Service]
# See `moip tx -h` and `moip devices` for the device options.
ExecStart=%h/moip-toolkit/bin/moip tx -n TX -d 0 --width 1920 --height 1080 --fps 30
WorkingDirectory=%h/moip-toolkit
Restart=always
RestartSec=3
# Cap memory so a runaway process is killed (and restarted) instead of taking down the OS
MemoryHigh=1G
MemoryMax=1500M

[Install]
WantedBy=default.target
