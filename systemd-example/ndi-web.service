[Unit]
Description=NDI Web GUI (FastAPI)
After=network.target

[Service]
ExecStart=%h/utone-ndi-utils/.venv/bin/python %h/utone-ndi-utils/main.py web
WorkingDirectory=%h/utone-ndi-utils
Restart=always
RestartSec=3
# Cap memory so a runaway process is killed (and restarted) instead of taking down the OS
MemoryHigh=1G
MemoryMax=1500M
Environment=XDG_RUNTIME_DIR=/run/user/%U

[Install]
WantedBy=default.target
