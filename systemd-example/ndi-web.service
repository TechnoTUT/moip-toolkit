[Unit]
Description=moip-toolkit web UI
After=network-online.target avahi-daemon.service
Wants=network-online.target

[Service]
ExecStart=%h/moip-toolkit/bin/moip web --host 0.0.0.0 --port 8000
# Lowest latency on a dedicated display machine (no desktop session; user in `video` and `input` groups):
#ExecStart=%h/moip-toolkit/bin/moip web --host 0.0.0.0 --port 8000 --video-driver kmsdrm
WorkingDirectory=%h/moip-toolkit
Restart=always
RestartSec=3
# Cap memory so a runaway process is killed (and restarted) instead of taking down the OS
MemoryHigh=1G
MemoryMax=1500M
Environment=XDG_RUNTIME_DIR=/run/user/%U

[Install]
WantedBy=default.target
