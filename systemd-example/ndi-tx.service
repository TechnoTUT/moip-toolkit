[Unit]
Description=NDI Sender
After=network.target

[Service]
ExecStart=%h/moip-toolkit/.venv/bin/python %h/moip-toolkit/main.py tx
WorkingDirectory=%h/moip-toolkit
Restart=always
RestartSec=3
# Cap memory so a runaway process is killed (and restarted) instead of taking down the OS
MemoryHigh=1G
MemoryMax=1500M

[Install]
WantedBy=default.target